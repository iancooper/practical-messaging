        <mxCell id="t6" value="a mailbox" style="text;html=1;align=center;fontFamily=Caveat;fontSize=16;fontColor=#C0453B;" vertex="1" parent="1">
          <mxGeometry x="530" y="164" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="sends, and carries on —&#10;it does not wait" style="text;html=1;align=center;fontFamily=Caveat;fontSize=15;fontColor=#8A8578;" vertex="1" parent="1">
          <mxGeometry x="135" y="324" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t8" value="collects when it is&#10;ready, not when the&#10;sender was" style="text;html=1;align=center;fontFamily=Caveat;fontSize=15;fontColor=#8A8578;" vertex="1" parent="1">
          <mxGeometry x="935" y="324" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t9" value="mail is delivered to a mailbox of some form,&#10;for later retrieval — the frame, from this morning" style="text;html=1;align=center;fontFamily=Caveat;fontSize=15;fontColor=#8A8578;" vertex="1" parent="1">
          <mxGeometry x="530" y="328" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t10" value="an asynchronous method of communication: the invoker sends, and relies on the receiver to select and run the code that answers it" style="text;html=1;align=center;fontFamily=Caveat;fontSize=15;fontColor=#8A8578;" vertex="1" parent="1">
          <mxGeometry x="540.0" y="462" width="120" height="20" as="geometry" />
