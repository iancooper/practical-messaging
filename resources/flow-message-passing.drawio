        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="both parties need not be present at the same time — because something in the middle holds the message" style="text;html=1;align=center;fontFamily=Caveat;fontSize=19;fontColor=#C0453B;" vertex="1" parent="1">
