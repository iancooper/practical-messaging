        <mxCell id="t7" value="sends, and carries on —&#10;it does not wait" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="80.2578108107723" y="264.8221081080128" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t8" value="collects when it is&#10;ready, not when the&#10;sender was" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="682.2361891888895" y="273.0993108107119" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t9" value="mail is delivered to a mailbox of some form,&#10;for later retrieval — the frame, from this morning" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="377.4846351349677" y="267.83199999990336" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t10" value="an asynchronous method of communication: the invoker sends, and&#10;relies on the receiver to select and run the code that answers it" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
