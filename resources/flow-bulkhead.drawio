        <mxCell id="t8" value="sends, and returns&#10;immediately — whether or&#10;not the receiver is up" style="text;html=1;align=center;fontFamily=Caveat;fontSize=15;fontColor=#8A8578;" vertex="1" parent="1">
          <mxGeometry x="135" y="384" width="120" height="20" as="geometry" />
        </mxCell>
