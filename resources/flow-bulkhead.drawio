        </mxCell>
        <mxCell id="t8" value="sends, and returns&#10;immediately — whether or&#10;not the receiver is up" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
