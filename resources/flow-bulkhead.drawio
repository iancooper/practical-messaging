        </mxCell>
        <mxCell id="t10" value="the failure is contained in one compartment: a bulkhead.&#10;In a synchronous conversation it would have propagated back up the chain." style="text;html=1;align=center;fontFamily=Caveat;fontSize=15;fontColor=#8A8578;" vertex="1" parent="1">
          <mxGeometry x="560" y="388" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t11" value="availabilities multiply only under temporal coupling — store-and-forward breaks the chain" style="text;html=1;align=center;fontFamily=Caveat;fontSize=15;fontColor=#8A8578;" vertex="1" parent="1">
