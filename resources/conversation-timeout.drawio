        </mxCell>
        <mxCell id="t2" value="the timeout expires, and nothing has come back" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#C0453B;" vertex="1" parent="1">
          <mxGeometry x="93.99999999999307" y="279.3999999999859" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="it never arrived  ·  the answer was lost  ·  it is still being worked on" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="384.99999999997544" y="321.3999999999833" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="so the provider has to be idempotent, or de-duplicate what it has already seen" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="384.99999999997544" y="459.39999999997497" width="120" height="20" as="geometry" />
