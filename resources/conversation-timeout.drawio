<mxfile host="practical-messaging" type="device">
  <diagram name="When Nothing Comes Back at All">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="1" pageWidth="890" pageHeight="517" background="#FDFCFA">
      <root>
