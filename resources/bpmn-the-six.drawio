        <mxCell id="t2" value="Receive" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDFCFA;strokeColor=#181B1F;fontColor=#181B1F;fontFamily=IBM Plex Sans;fontSize=13;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="101" y="352" width="190" height="56" as="geometry" />
