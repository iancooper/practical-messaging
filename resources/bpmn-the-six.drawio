<mxfile host="practical-messaging" type="device">
  <diagram name="BPMN — the Six That Do the Work">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="580" background="#FDFCFA">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
