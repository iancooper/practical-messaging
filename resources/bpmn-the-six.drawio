        <mxCell id="e4" value="Timer" style="shape=mxgraph.bpmn.shape;perimeter=ellipsePerimeter;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;outlineConnect=0;outline=eventInt;symbol=timer;html=1;fillColor=#FDFCFA;strokeColor=#181B1F;fontColor=#181B1F;fontFamily=IBM Plex Sans;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="583" y="363" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t8" value="enough time passed,&#10;and nothing arrived" style="text;html=1;align=center;fontFamily=Caveat;fontSize=14;fontColor=#2F5D3A;" vertex="1" parent="1">
