<mxfile host="practical-messaging" type="device">
  <diagram name="If Later — on a Stream">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="440" background="#FDFCFA">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="the late message is discarded, not repaired — v3 already says everything v2 says" style="text;html=1;align=center;fontFamily=Caveat;fontSize=19;fontColor=#C0453B;" vertex="1" parent="1">
          <mxGeometry x="500" y="32" width="120" height="20" as="geometry" />
