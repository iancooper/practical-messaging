        <mxCell id="t10" value="nothing says" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#181B1F;" vertex="1" parent="1">
          <mxGeometry x="334.3762771084242" y="300.11905805034655" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t11" value="when do I look?" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="467.0148313252723" y="280.8261774369868" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t12" value="you decide" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#181B1F;" vertex="1" parent="1">
          <mxGeometry x="467.0148313252723" y="300.11905805034655" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t13" value="a file is a message: a batch of them, in a channel that happens to be a filesystem" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
