<mxfile host="practical-messaging" type="device">
  <diagram name="File Transfer">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="570" background="#FDFCFA">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="g2" value="producer process" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Caveat;html=1;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fillColor=none;strokeColor=#8A8578;strokeWidth=1.4;fontColor=#2F5D3A;fontSize=18;dashed=1;dashPattern=6 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="124" width="390" height="176" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="consumer process" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Caveat;html=1;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fillColor=none;strokeColor=#8A8578;strokeWidth=1.4;fontColor=#2F5D3A;fontSize=18;dashed=1;dashPattern=6 5;" vertex="1" parent="1">
          <mxGeometry x="570" y="124" width="390" height="176" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="the file is the contract — its format and where it lives, and nothing else is agreed" style="text;html=1;align=center;fontFamily=Caveat;fontSize=21;fontColor=#C0453B;" vertex="1" parent="1">
          <mxGeometry x="440" y="32" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="the process boundary" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#181B1F;" vertex="1" parent="1">
          <mxGeometry x="440" y="88" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Caveat;html=1;shape=line;direction=north;strokeColor=#181B1F;strokeWidth=1.7;fillColor=none;fontColor=#181B1F;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="500" y="108" width="1" height="162" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Application" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Caveat;html=1;rounded=1;arcSize=12;strokeColor=#181B1F;strokeWidth=1.7;fillColor=none;fontColor=#181B1F;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="70" y="170" width="240" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Application" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Caveat;html=1;rounded=1;arcSize=12;strokeColor=#181B1F;strokeWidth=1.7;fillColor=none;fontColor=#181B1F;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="690" y="170" width="240" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Caveat;html=1;shape=note;size=0;verticalLabelPosition=bottom;verticalAlign=top;strokeColor=#C0453B;strokeWidth=1.7;fillColor=#FDFCFA;fontColor=#C0453B;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="464" y="158" width="72" height="112" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="a file, in a directory both can reach — it waits there until somebody comes for it" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#181B1F;" vertex="1" parent="1">
          <mxGeometry x="440" y="310" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="and every one of these is yours to write" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="440" y="368" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r7" value="" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Caveat;html=1;shape=line;strokeColor=#8A8578;strokeWidth=1.7;fillColor=none;fontColor=#8A8578;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="402" width="880" height="1" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="in what order?" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="110" y="420" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="none" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#181B1F;" vertex="1" parent="1">
          <mxGeometry x="110" y="452" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="who locks it?" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="330" y="420" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t8" value="you do" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#181B1F;" vertex="1" parent="1">
          <mxGeometry x="330" y="452" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t9" value="did it land?" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="550" y="420" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t10" value="nothing says" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#181B1F;" vertex="1" parent="1">
          <mxGeometry x="550" y="452" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t11" value="when do I look?" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="770" y="420" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t12" value="you decide" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#181B1F;" vertex="1" parent="1">
          <mxGeometry x="770" y="452" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t13" value="a file is a message: a batch of them, in a channel that happens to be a filesystem" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="440" y="530" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="writes it" style="sketch=1;jiggle=2;curveFitting=1;edgeStyle=none;rounded=0;strokeColor=#1D4E6B;strokeWidth=1.8;fontFamily=Caveat;fontSize=18;fontColor=#1D4E6B;html=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="reads it" style="sketch=1;jiggle=2;curveFitting=1;edgeStyle=none;rounded=0;strokeColor=#1D4E6B;strokeWidth=1.8;fontFamily=Caveat;fontSize=18;fontColor=#1D4E6B;html=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="n5">
