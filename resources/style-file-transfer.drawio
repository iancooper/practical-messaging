        </mxCell>
        <mxCell id="t3" value="a file, in a directory both can reach — it waits there until somebody comes for it" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#181B1F;" vertex="1" parent="1">
          <mxGeometry x="384.9999999998344" y="291.6608695651173" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="and every one of these is yours to write" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
