<mxfile host="practical-messaging" type="device">
  <diagram name="Call and Return, and the God Object">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="1" pageWidth="1240" pageHeight="640" background="#FDFCFA">
