        </mxCell>
        <mxCell id="t11" value="not a packet on a port —&#10;a table B reads, so nothing waits" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="361.32977777771504" y="230.79102222219169" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t12" value="in advance rather than on demand: no temporal coupling, and the copy is&#10;behind by one broker hop. The alternative is a lookup port — ask A, and wait." style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
