        </mxCell>
        <mxCell id="t7" value="this is a queue, not a stream — it carries messages,&#10;and a message that must be ordered cannot use it.&#10;For those, requeue with delay, or a sequencer." style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
