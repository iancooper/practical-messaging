        </mxCell>
        <mxCell id="t4" value="an operation name, not data — you are telling the other side what to do, which is control coupling" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
