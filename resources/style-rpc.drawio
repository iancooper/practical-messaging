<mxfile host="practical-messaging" type="device">
  <diagram name="Remote Procedure Call">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="510" background="#FDFCFA">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="g2" value="client process" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Caveat;html=1;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fillColor=none;strokeColor=#8A8578;strokeWidth=1.4;fontColor=#2F5D3A;fontSize=17;dashed=1;dashPattern=6 5;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="340" height="190" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="server process" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Caveat;html=1;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fillColor=none;strokeColor=#8A8578;strokeWidth=1.4;fontColor=#2F5D3A;fontSize=17;dashed=1;dashPattern=6 5;" vertex="1" parent="1">
          <mxGeometry x="800" y="140" width="340" height="190" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="the only style that loses on both axes at once — you say what to do, and you wait while it is done" style="text;html=1;align=center;fontFamily=Caveat;fontSize=19;fontColor=#C0453B;" vertex="1" parent="1">
          <mxGeometry x="540" y="36" width="120" height="20" as="geometry" />
        </mxCell>
