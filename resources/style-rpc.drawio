        </mxCell>
        <mxCell id="t5" value="and both must be up at the same moment, so an outage here is not a delay, it is a failure" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
