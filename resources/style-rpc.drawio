          <mxGeometry x="330" y="153" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="blocked until it comes back" style="text;html=1;align=center;fontFamily=Caveat;fontSize=17;fontColor=#C0453B;" vertex="1" parent="1">
          <mxGeometry x="285" y="116" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="an operation name, not data — you are telling the other side what to do, which is control coupling" style="text;html=1;align=center;fontFamily=Caveat;fontSize=16;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="540" y="412" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="and both must be up at the same moment, so an outage here is not a delay, it is a failure" style="text;html=1;align=center;fontFamily=Caveat;fontSize=16;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="540" y="452" width="120" height="20" as="geometry" />
        </mxCell>
