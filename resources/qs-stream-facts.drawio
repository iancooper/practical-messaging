          <mxGeometry x="805" y="424" width="180" height="62" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="an offset is a consumer's own bookmark. On restart&#10;it reads the store to find the last record it processed." style="text;html=1;align=center;fontFamily=Caveat;fontSize=15;fontColor=#8A8578;" vertex="1" parent="1">
