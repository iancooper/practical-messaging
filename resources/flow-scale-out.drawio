        <mxCell id="t11" value="add one — throughput goes up" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#C0453B;" vertex="1" parent="1">
          <mxGeometry x="564.6367510330549" y="188.0727789256191" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t12" value="lose one — the rest do not notice" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#C0453B;" vertex="1" parent="1">
          <mxGeometry x="564.6367510330549" y="268.9798553718997" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t13" value="the Supervisor does not know how&#10;many there are — which is why both&#10;of those are free" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="101.91477272727212" y="265.65490702479224" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t14" value="resilient and elastic are not aspirations. They are message&#10;passing, backpressure, a circuit breaker and this." style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
