        </mxCell>
        <mxCell id="t3" value="available to lock again,&#10;often after a delay — the&#10;failure may be transient" style="text;html=1;align=center;fontFamily=Caveat;fontSize=14;fontColor=#8A8578;" vertex="1" parent="1">
