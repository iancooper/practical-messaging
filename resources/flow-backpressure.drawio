        </mxCell>
        <mxCell id="t9" value="blocking retry creates it as a side effect: retrying a&#10;connection slows consumption, which fills the queue" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="384.93810795445194" y="359.58239772719793" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t10" value="choose it when data loss is unacceptable and the extra latency is tolerable" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
