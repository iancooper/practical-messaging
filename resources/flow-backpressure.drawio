        </mxCell>
        <mxCell id="t9" value="blocking retry creates it as a side effect: retrying a&#10;connection slows consumption, which fills the queue" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
