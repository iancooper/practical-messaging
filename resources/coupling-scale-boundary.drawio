        <mxCell id="r2" value="" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Caveat;html=1;shape=line;strokeColor=#C0453B;strokeWidth=1.7;fillColor=none;fontColor=#C0453B;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="188" y="200" width="124" height="1" as="geometry" />
        </mxCell>
        <mxCell id="t8" value="prevented" style="text;html=1;align=center;fontFamily=Caveat;fontSize=14;fontColor=#C0453B;" vertex="1" parent="1">
          <mxGeometry x="108" y="194" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t9" value="Control" style="text;html=1;align=center;fontFamily=Caveat;fontSize=22;fontColor=#181B1F;" vertex="1" parent="1">
          <mxGeometry x="190" y="321" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t10" value="one party tells the other what to do" style="text;html=1;align=center;fontFamily=Caveat;fontSize=14;fontColor=#8A8578;" vertex="1" parent="1">
