        <mxCell id="t17" value="separate processes, private data,&#10;no shared transaction" style="text;html=1;align=center;fontFamily=Caveat;fontSize=14;fontColor=#8A8578;" vertex="1" parent="1">
          <mxGeometry x="860" y="276" width="120" height="20" as="geometry" />
