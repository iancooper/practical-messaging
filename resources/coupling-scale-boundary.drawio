<mxfile host="practical-messaging" type="device">
  <diagram name="The Coupling Scale, with a Process Boundary Across It">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="1" pageWidth="980" pageHeight="560" background="#FDFCFA">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="the two worst kinds of coupling are the two you cannot have any more — that is what you bought" style="text;html=1;align=center;fontFamily=Caveat;fontSize=19;fontColor=#C0453B;" vertex="1" parent="1">
          <mxGeometry x="430" y="32" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="tightest" style="text;html=1;align=center;fontFamily=Caveat;fontSize=13;fontColor=#8A8578;" vertex="1" parent="1">
          <mxGeometry x="190" y="92" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="Content" style="text;html=1;align=center;fontFamily=Caveat;fontSize=22;fontColor=#8A8578;" vertex="1" parent="1">
          <mxGeometry x="190" y="127" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="one party reaches into the other's internals" style="text;html=1;align=center;fontFamily=Caveat;fontSize=14;fontColor=#8A8578;" vertex="1" parent="1">
          <mxGeometry x="320" y="126" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Caveat;html=1;shape=line;strokeColor=#C0453B;strokeWidth=1.7;fillColor=none;fontColor=#C0453B;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="188" y="132" width="124" height="1" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="prevented" style="text;html=1;align=center;fontFamily=Caveat;fontSize=14;fontColor=#C0453B;" vertex="1" parent="1">
          <mxGeometry x="108" y="126" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="Common" style="text;html=1;align=center;fontFamily=Caveat;fontSize=22;fontColor=#8A8578;" vertex="1" parent="1">
          <mxGeometry x="190" y="195" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="both parties share the same mutable store" style="text;html=1;align=center;fontFamily=Caveat;fontSize=14;fontColor=#8A8578;" vertex="1" parent="1">
          <mxGeometry x="320" y="194" width="120" height="20" as="geometry" />
