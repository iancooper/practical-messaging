        <mxCell id="t11" value="Stamp" style="text;html=1;align=center;fontFamily=Caveat;fontSize=22;fontColor=#181B1F;" vertex="1" parent="1">
          <mxGeometry x="190" y="389" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t12" value="a whole structure is passed, and part of it used" style="text;html=1;align=center;fontFamily=Caveat;fontSize=14;fontColor=#8A8578;" vertex="1" parent="1">
          <mxGeometry x="320" y="388" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t13" value="Data" style="text;html=1;align=center;fontFamily=Caveat;fontSize=22;fontColor=#181B1F;" vertex="1" parent="1">
