        <mxCell id="t6" value="the arc: a pipe with a capacity, and it is full" style="text;html=1;align=center;fontFamily=Caveat;fontSize=17;fontColor=#C0453B;" vertex="1" parent="1">
          <mxGeometry x="535" y="178" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="push — something arrived&#10;and there is work to do" style="text;html=1;align=center;fontFamily=Caveat;fontSize=17;fontColor=#181B1F;" vertex="1" parent="1">
          <mxGeometry x="100" y="354" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t8" value="pull — a sink asked&#10;for work" style="text;html=1;align=center;fontFamily=Caveat;fontSize=17;fontColor=#181B1F;" vertex="1" parent="1">
          <mxGeometry x="950" y="354" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t9" value="buffers are what let the two run at once: price can push&#10;while total is still busy. Throughput is then the slowest node." style="text;html=1;align=center;fontFamily=Caveat;fontSize=16;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="535" y="360" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t10" value="links with infinite capacity exist only in theory, so when the buffer fills there are exactly two answers: slow the producer, or drop data" style="text;html=1;align=center;fontFamily=Caveat;fontSize=16;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="540.0" y="474" width="120" height="20" as="geometry" />
        </mxCell>
