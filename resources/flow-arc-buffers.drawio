        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="we do not fire a node to read its input if there is no space on its output — a full buffer is the whole of backpressure" style="text;html=1;align=center;fontFamily=Caveat;fontSize=19;fontColor=#C0453B;" vertex="1" parent="1">
