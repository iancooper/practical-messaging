        <mxCell id="t6" value="the arc: a pipe with a capacity, and it is full" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#C0453B;" vertex="1" parent="1">
          <mxGeometry x="345.3975898806747" y="141.7491772932839" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="push — something arrived&#10;and there is work to do" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#181B1F;" vertex="1" parent="1">
          <mxGeometry x="57.43599999999998" y="258.2577745783385" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t8" value="pull — a sink asked&#10;for work" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#181B1F;" vertex="1" parent="1">
          <mxGeometry x="620.1195664335022" y="258.2577745783385" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t9" value="buffers are what let the two run at once: price can push&#10;while total is still busy. Throughput is then the slowest node." style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="345.3975898806747" y="262.2296585766926" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t10" value="links with infinite capacity exist only in theory, so when the buffer&#10;fills there are exactly two answers: slow the producer, or drop data" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="348.70749321263645" y="337.69545454542117" width="120" height="20" as="geometry" />
        </mxCell>
