        </mxCell>
        <mxCell id="t11" value="not a packet on a port — a table B reads, so nothing waits" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="400.6186104650338" y="458.2224372092213" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t12" value="in advance rather than on demand: no temporal coupling, and the&#10;copy is behind by one broker hop — which is the trade you are making" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
