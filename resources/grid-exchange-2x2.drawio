        <mxCell id="t1" value="In and Out are named from the provider's side — In = a message arrives, Out = a message leaves" style="text;html=1;align=center;fontFamily=Caveat;fontSize=19;fontColor=#C0453B;" vertex="1" parent="1">
          <mxGeometry x="440" y="36" width="120" height="20" as="geometry" />
