        </mxCell>
        <mxCell id="t10" value="its work goes back on the&#10;queue and another worker&#10;takes it" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
