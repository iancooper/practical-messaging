        </mxCell>
        <mxCell id="t12" value="resilient and elastic are not aspirations. They are message&#10;passing, backpressure, a circuit breaker and this." style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
