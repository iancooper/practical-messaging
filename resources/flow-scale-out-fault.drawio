        </mxCell>
        <mxCell id="t10" value="its work goes back on the&#10;queue and another worker&#10;takes it" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
          <mxGeometry x="608.3901020404597" y="333.4979836733057" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t11" value="the Supervisor replaces it —&#10;it was never holding&#10;anything the worker knew" style="text;html=1;align=center;fontFamily=Caveat;fontSize=18;fontColor=#2F5D3A;" vertex="1" parent="1">
